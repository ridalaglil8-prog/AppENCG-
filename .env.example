# NextStep Maroc — variables d'environnement (exemple)
# Copier ce fichier vers .env et renseigner des valeurs propres.
# NE JAMAIS committer le fichier .env.

# Environnement d'exécution : development | production
NEXTSTEP_ENV=development

# Chaîne de connexion SQLAlchemy.
# SQLite (défaut) : l'URL est résolue par rapport à la racine du projet.
# PostgreSQL (migration future) : postgresql+psycopg2://user:password@host:5432/nextstep
NEXTSTEP_DATABASE_URL=sqlite:///data/nextstep.db

# Clé secrète — RÉSERVÉE aux évolutions futures (signatures de jetons, etc.).
# Elle n'est pas lue par le MVP actuel ; elle est documentée ici pour qu'aucune
# clé ne soit jamais codée en dur dans le code source.
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
NEXTSTEP_SECRET_KEY=change-me-with-a-random-64-chars-hex-value

# Initialisation du premier administrateur (utilisée par : python manage.py create-admin)
# Ces valeurs sont des exemples NON valides : elles doivent être remplacées.
NEXTSTEP_ADMIN_EMAIL=admin@example.com
NEXTSTEP_ADMIN_PASSWORD=ChangeMe-Strong-Passw0rd!
NEXTSTEP_ADMIN_LANGUAGE=fr

# Charger le jeu de données de démonstration au démarrage (true/false)
NEXTSTEP_SEED_DEMO_DATA=false

# Limitation des tentatives de connexion
NEXTSTEP_MAX_LOGIN_ATTEMPTS=5
NEXTSTEP_LOGIN_LOCK_SECONDS=300
